# ---------- Majburiy ----------
TELEGRAM_BOT_TOKEN=
GEMINI_API_KEY=

# Lokal: bo'sh qoldirilsa SQLite (./adam.db) ishlatiladi.
# Production: postgresql+asyncpg://user:pass@host:5432/db  (postgres:// ham qabul qilinadi)
DATABASE_URL=

# Lokal: bo'sh qoldirilsa in-memory fallback ishlatiladi (faqat bitta jarayon uchun).
# Production: redis://... yoki rediss://... (Upstash)
REDIS_URL=

# Mini App manzili (Netlify). CORS faqat shu manzilga ruxsat beradi.
FRONTEND_URL=http://localhost:5173
# Bot WebApp tugmasi ochadigan manzil (HTTPS bo'lishi shart, odatda FRONTEND_URL bilan bir xil)
WEBAPP_URL=https://your-app.netlify.app
# Backendning ommaviy HTTPS manzili (production webhook uchun)
BACKEND_URL=

# development | production
ENVIRONMENT=development
# auto (dev=polling, prod=webhook) | polling | webhook | disabled
BOT_MODE=auto
# Webhook so'rovlarini tekshirish uchun maxfiy token (production)
WEBHOOK_SECRET=

# ---------- Gemini Live ----------
GEMINI_MODEL=gemini-3.8-live
# Asosiy model ulanmasa sinab ko'riladigan zaxira modellar (vergul bilan)
GEMINI_FALLBACK_MODELS=gemini-2.5-flash-native-audio-preview-12-2025
GEMINI_VOICE=Puck
# Guruh repetitori va kanal kunlik darslari uchun matn modeli
GEMINI_TEXT_MODEL=gemini-3.8-flash
GEMINI_TEXT_FALLBACK_MODEL=gemini-2.5-flash

# ---------- Tariflar va to'lov ----------
# Chek tekshirish uchun ALOHIDA Gemini kaliti (bo'sh bo'lsa GEMINI_API_KEY ishlatiladi)
RECEIPT_GEMINI_API_KEY=
RECEIPT_MODEL=gemini-3.1-pro-preview
RECEIPT_FALLBACK_MODEL=gemini-3.8-flash
# Pul tushadigan karta (foydalanuvchiga ko'rsatiladi) va egasining ismi
PAYMENT_CARD_NUMBER=
PAYMENT_CARD_HOLDER=
PRO_PRICE=29000
MAX_PRICE=69000
PLAN_DAYS=30
# Shubhali cheklarni tasdiqlovchi adminlar Telegram ID'lari (vergul bilan)
ADMIN_IDS=
# Gemini ishonchi shundan past bo'lsa — admin tekshiradi
RECEIPT_AUTO_MIN_CONFIDENCE=0.85
# Bundan eski chek avtomatik qabul qilinmaydi (soat)
RECEIPT_MAX_AGE_HOURS=72
# Kanallarga kunlik dars vaqti (mahalliy soat) va vaqt mintaqasi (Toshkent = 5)
DAILY_LESSON_HOUR=9
TZ_OFFSET_HOURS=5

# ---------- Sessiya ----------
LOG_LEVEL=INFO
SESSION_TIMEOUT_SECONDS=900
# Bir foydalanuvchi daqiqasiga nechta WS ulanish ochishi mumkin
WS_RATE_LIMIT_PER_MINUTE=10
# initData eskirish muddati (soniya)
INIT_DATA_MAX_AGE=86400

# Faqat ENVIRONMENT=development da ishlaydi: brauzerda Telegram'siz test (init_data=dev:<id>)
ALLOW_DEV_AUTH=false
